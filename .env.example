# انسخ هذا الملف إلى .env.local (غير مرفوع على GitHub) واملأ القيم من
# Firebase Console > Project settings > Your apps > Web app.
# على Vercel: Project > Settings > Environment Variables (نفس الأسماء).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# اختياري: رقم واتساب المتجر بالصيغة الدولية بدون + (مثال: 201012345678). بيظهر خيار "أرسل الطلب عبر واتساب" في صفحة إتمام الشراء. لو فاضي الخيار مش بيظهر.
VITE_WHATSAPP_NUMBER=

# اختياري: رقم محفظة اتصالات كاش (11 رقم يبدأ بـ 011). لو فاضي خيار التحويل على المحفظة مش بيظهر.
VITE_WALLET_NUMBER=

# اختياري لكن موصى به: مفتاح reCAPTCHA v3 (site key) لتفعيل App Check
VITE_RECAPTCHA_SITE_KEY=
